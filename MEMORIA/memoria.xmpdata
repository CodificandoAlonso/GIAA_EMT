\Title{Sistema Multi-Agente de simulación de autobuses para evaluación de la
       dotación programada mediante KPIs}
\Author{Héctor Álvarez Marcos}
\Language{es-ES}
\Keywords{Sistemas multi-agente\sep simulación de Monte Carlo\sep transporte
          público urbano\sep transporte inteligente\sep indicadores clave de
          rendimiento\sep GAMA}
\Subject{Trabajo Fin de Grado que determina en qué medida un sistema multiagente
         parametrizado con datos operacionales reales reproduce el comportamiento
         observado de una línea de autobús urbano y sostiene el cálculo de
         indicadores clave de rendimiento sobre la dotación programada.}
