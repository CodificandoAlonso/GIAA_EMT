# ============================================================================
# Project configuration
# ============================================================================

TARGET      := simulation

CC          := gcc

CSTD        := c17

# Compiler warnings and language options
CFLAGS      := -std=$(CSTD) \
               -Wall \
               -Wextra \
               -Wpedantic \
               -Wconversion \
               -Wshadow \
               -Wformat=2 \
               -Wundef \
               -Werror=implicit-function-declaration \
               -MMD \
               -MP \
			   -pthread

# Include directories
CPPFLAGS    := -Isrc

# Libraries
LDLIBS      := -lm

# Debug / optimization
DEBUG_FLAGS := -g3 -O0
RELEASE_FLAGS := -O3 -DNDEBUG


# ============================================================================
# Directories
# ============================================================================

SRC_DIR     := src
BUILD_DIR   := build

# Find every .c file recursively under src/
SOURCES     := $(shell find $(SRC_DIR) -type f -name '*.c')

# Convert:
#   src/foo/bar.c
#
# into:
#   build/foo/bar.o
OBJECTS     := $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SOURCES))

# Dependency files generated by GCC
DEPS        := $(OBJECTS:.o=.d)


# ============================================================================
# Default target
# ============================================================================

.PHONY: all
all: $(TARGET)


# ============================================================================
# Linking
# ============================================================================

$(TARGET): $(OBJECTS)
	@echo "  LD      $@"
	$(CC) $(OBJECTS) -o $@ $(LDLIBS)


# ============================================================================
# Compilation
# ============================================================================

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@


# ============================================================================
# Build configurations
# ============================================================================

.PHONY: debug
debug: CFLAGS += $(DEBUG_FLAGS)
debug: clean
debug: $(TARGET)

.PHONY: release
release: CFLAGS += $(RELEASE_FLAGS)
release: clean
release: $(TARGET)


# ============================================================================
# Run
# ============================================================================

.PHONY: run
run: $(TARGET)
	./$(TARGET)


# ============================================================================
# Cleaning
# ============================================================================

.PHONY: clean
clean:
	@echo "  CLEAN"
	rm -rf $(BUILD_DIR) $(TARGET)


.PHONY: rebuild
rebuild: clean all


# ============================================================================
# Dependency files
# ============================================================================

-include $(DEPS)


# ============================================================================
# Help
# ============================================================================

.PHONY: help
help:
	@echo "Available targets:"
	@echo "  make          Build the project"
	@echo "  make debug    Build with debugging symbols and no optimization"
	@echo "  make release  Build optimized release version"
	@echo "  make run      Build and run the simulation"
	@echo "  make clean    Remove build files and executable"
	@echo "  make rebuild  Clean and rebuild everything"