    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from scipy.stats import norm\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def histogram_with_normal(data_to_hist, variable):\\n\",\n",
    "    \"    data = np.asarray(data_to_hist[variable])\\n\",\n",
    "    \"    mu = np.mean(data)\\n\",\n",
    "    \"    sigma = np.std(data, ddof=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Histograma en densidad\\n\",\n",
    "    \"    plt.hist(data,bins = 15, density=True, alpha=0.5, label=\\\"Datos\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    x = np.linspace(min(data), max(data), 400)\\n\",\n",
    "    \"    y = norm.pdf(x, loc=mu, scale=sigma)\\n\",\n",
    "    \"    plt.plot(x, y, 'r-', lw=2, label=f\\\"N({mu:.2f}, {sigma:.2f}²)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.xlabel(variable)\\n\",\n",
    "    \"    plt.ylabel('Densidad')\\n\",\n",
    "    \"    plt.title(f\\\"Histograma de {variable} + Normal ajustada\\\")\\n\",\n",
    "    \"    plt.xticks(rotation=29)\\n\",\n",
    "    \"    plt.grid(True, alpha=0.3)\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"histogram_with_normal(data_22_9, \\\"Occupation\\\")\"\n",
    "   ],\n",
